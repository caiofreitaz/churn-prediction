# ============================================================
# Churn Predictor — Environment Variables
# ============================================================
# Copie este arquivo para .env e ajuste conforme necessário.
# Os valores aqui são os defaults definidos em utils/config.py.
# ============================================================

# ----- Reprodutibilidade -----
RANDOM_SEED=42

# ----- Dataset -----
DATASET_FILENAME=WA_Fn-UseC_-Telco-Customer-Churn.csv
TARGET_COLUMN=Churn
TEST_SIZE=0.2
VAL_SIZE=0.15
CV_FOLDS=5

# ----- MLflow -----
# MLFLOW_TRACKING_URI=file:///path/to/mlruns
# MLFLOW_TRACKING_URI=http://localhost:5000   # se usar tracking server
MLFLOW_EXPERIMENT_NAME=churn-prediction

# ----- API -----
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info

# ----- Logging -----
LOG_LEVEL=INFO
LOG_FORMAT=json   # "json" ou "console"

# ----- Análise de custo (negócio) -----
COST_FALSE_NEGATIVE=500.0
COST_FALSE_POSITIVE=50.0
